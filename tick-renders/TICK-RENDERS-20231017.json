{
 "what": "Greg's three renders for the whole trade day, timed at the tick, and the dipoles that line up with trade legs as stacked pairs",
 "asked": "Greg, 2026-11-18: \"the trade price curve ... dipole and exhaustion ticked by nano\"; \"We have a lot of trade legs that line up exactly with dipoles ... Let's start there\"",
 "trade_day": "2023-10-17",
 "tick_columns": [
  {
   "column": "position_on_tape",
   "what": "The tick: its position on the tape. A label only."
  },
  {
   "column": "received_time_ns",
   "what": "When the tick was received."
  },
  {
   "column": "run_side",
   "what": "The run of trades on one side under way at this tick: buy or sell. Empty before the first trade with a side."
  },
  {
   "column": "run_size",
   "what": "The size traded in that run so far (a run's size adds its trades together)."
  },
  {
   "column": "run_before_size",
   "what": "The size of the run it took over from, at that run's last trade. Empty until there has been one change of hands."
  },
  {
   "column": "dipole_at_tick",
   "what": "THE DIPOLE at the tick: the latest run of buying minus the latest run of selling, over the two together. +1 all buying, -1 all selling. Empty until there has been one change of hands."
  },
  {
   "column": "exhaustion_at_tick",
   "what": "THE EXHAUSTION at the tick: the size of the run under way, above zero for buying and below for selling."
  },
  {
   "column": "run_high",
   "what": "Yes on the last trade of a run that a trade on the other side then ended: the high of the peak with no window. Known only at that later trade."
  }
 ],
 "pair_columns": [
  {
   "column": "dipole",
   "what": "Native's candidate number. A label only."
  },
  {
   "column": "native_birth_ns",
   "what": "Native's birth time: the start of the birth second, on the received clock."
  },
  {
   "column": "native_polarity",
   "what": "Native's polarity: +1 net buying, -1 net selling."
  },
  {
   "column": "trades_in_birth_second",
   "what": "How many trades printed in the birth second."
  },
  {
   "column": "leg_number",
   "what": "The trade leg whose FIRST trade is in the birth second. Empty when no trade leg starts in it."
  },
  {
   "column": "leg_direction",
   "what": "Which way that trade leg went."
  },
  {
   "column": "leg_steps",
   "what": "How many steps it made. Empty when it was still going at the last tick."
  },
  {
   "column": "leg_first_trade_position",
   "what": "Its first trade: position on the tape. A label only."
  },
  {
   "column": "render",
   "what": "The stacked pair drawn for it. Empty when no trade leg starts in the birth second."
  }
 ],
 "counts": {
  "ticks": 845246,
  "trades": 33703,
  "runs_of_trades_ended": 10401,
