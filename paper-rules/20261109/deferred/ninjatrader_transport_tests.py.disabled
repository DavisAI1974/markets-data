import tempfile
import unittest
from pathlib import Path
from paper_rules.ninjatrader import FileTransport, Order, format_place, parse_update


class NinjaTransportTests(unittest.TestCase):
    def order(self, **changes):
        values=dict(account='Sim101',instrument='NG 12-26',action='BUY',quantity=1,limit_price='3.212',time_in_force='DAY',order_id='paper_abc')
        values.update(changes)
        return Order(**values)

    def test_source_documented_format_has_thirteen_fields(self):
        self.assertEqual(format_place(self.order()),'PLACE;Sim101;NG 12-26;BUY;1;LIMIT;3.212;;DAY;;paper_abc;;\n')

    def test_live_account_and_delimiter_injection_are_rejected(self):
        for change in [dict(account='123456'),dict(instrument='NG;SELL'),dict(order_id='x\nPLACE'),dict(quantity=True),dict(limit_price='NaN')]:
            with self.subTest(change=change),self.assertRaises(ValueError):format_place(self.order(**change))

    def test_ioc_cannot_silently_become_day(self):
        with self.assertRaises(ValueError):format_place(self.order(time_in_force='IOC'))

    def test_write_acknowledgement_is_not_fill(self):
        with tempfile.TemporaryDirectory() as path:
            transport=FileTransport(Path(path),enabled=True)
            result=transport.submit(self.order())
            self.assertEqual(result['status'],'INSTRUCTION_WRITTEN')
            self.assertIsNone(result['filled_quantity'])
            self.assertEqual(len(list((Path(path)/'incoming').glob('oif*.txt'))),1)

    def test_duplicate_id_stays_blocked_after_restart(self):
        with tempfile.TemporaryDirectory() as path:
            transport=FileTransport(Path(path),enabled=True)
            transport.submit(self.order())
            transport=FileTransport(Path(path),enabled=True)
            with self.assertRaises(ValueError):transport.submit(self.order())

    def test_unknown_order_cannot_be_cancelled(self):
        with tempfile.TemporaryDirectory() as path:
            transport=FileTransport(Path(path),enabled=True)
            with self.assertRaises(ValueError):transport.cancel('not_owned')

    def test_disabled_transport_writes_no_order(self):
        with tempfile.TemporaryDirectory() as path:
            transport=FileTransport(Path(path))
            with self.assertRaises(RuntimeError):transport.submit(self.order())
            self.assertFalse(list((Path(path)/'incoming').glob('oif*.txt')))

    def test_platform_cumulative_fill_is_not_invented_execution_timestamp(self):
        result=parse_update('PartFilled;1;3.212',ordered_quantity=2,observed_ns='100')
        self.assertEqual(result['filled_quantity'],1)
        self.assertEqual(result['average_fill_price'],'3.212')
        self.assertIsNone(result['execution_ns'])
        self.assertIsNone(result['execution_id'])

    def test_malformed_or_overfilled_platform_update_rejected(self):
        for content in ['Filled;2;3.2','Filled;1;NaN','Filled;0;0','Working;bad;0']:
            with self.subTest(content=content),self.assertRaises(ValueError):parse_update(content,ordered_quantity=1,observed_ns='100')

if __name__=='__main__':unittest.main()
